#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=36
#SBATCH --mem=240G
#SBATCH --gpus=2
#SBATCH --job-name=train_test
#SBATCH --time=10:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

export TORCH_USE_CUDA_DSA=1

nvidia-smi


srun python train_eval.py \
    device=snellius \
    dataset=synthetic_remotap_swir1_spectrometer_only_LHS_matched_retrieval_era5_paper \
    dataset.normalization.per_wavelength=false \
    model=SequenceNNSurrogateRTM_proxy_input_tempPCA_input_processing_const_lr \
    model.nonlinearity=silu \
    model.forward_model.sequence_module.kernel_size=5 \
    model.n_layers=2 \
    model.decrease_channels=2 \
    model.hidden_dim=128 \
    model.dropout_p=0.001 \
    logger.project=spectrometer_only_swir1_era5_paper \
    transforms=log_targets_log_proxy_log_albedo_era5 \
    task.final_eval=true \
    task.save_predictions=true \
    seed=0 \
    task.data_frac=1.0 \
    task.measure_cpu_time=false \
    trainer.max_epochs=75 \
    model.lr=1e-4
