#!/bin/bash

#SBATCH --partition=thin
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --job-name=prepare_data
#SBATCH --time=1:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

srun python prepare_data.py device=snellius dataset=synthetic_remotap_nir_era5_only_gas_profiles logger.project=era5_inputs_nir