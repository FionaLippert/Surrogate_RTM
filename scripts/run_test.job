#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --job-name=train_test
#SBATCH --time=4:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

model_path="/projects/0/prjs1294/output/results/spectrometer_only_swir1/default/logs/wandb/run-20250820_132706-6urvx3d8/files/checkpoints/last.ckpt" # ratio MLP-PCA SWIR1 spectrometer-only, fixed PCA, dropout=0.001

srun python train_eval.py device=snellius dataset=synthetic_remotap_swir1_ratio_spectrometer_only_LHS model=MLP_PCA_Ratio model.output_latent_dim=128 model.hidden_dim=128 model.nonlinearity=silu logger.project=spectrometer_only_swir1_finetuning task.final_eval=true task.save_predictions=true seed=0 task=eval task.model_path=$model_path
