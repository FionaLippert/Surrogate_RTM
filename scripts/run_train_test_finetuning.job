#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=36
#SBATCH --mem=240G
#SBATCH --gpus=2
#SBATCH --job-name=finetuning
#SBATCH --time=10:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

export TORCH_USE_CUDA_DSA=1

nvidia-smi


model_path="/projects/0/prjs1294/output/results/spectrometer_only_swir3/default/logs/wandb/run-20251029_155339-532e7egj/files/checkpoints/last.ckpt" # MLP-PCA SWIR3 trainable PCA, hidden dim = PCA dim = 210, new training data
srun python train_eval.py device=snellius dataset=synthetic_remotap_retrieval_swir3_spectrometer_only_LHS_training_ranges model=MLP_PCA model.output_latent_dim=210 model.hidden_dim=210 model.input_latent_dim=210 model.nonlinearity=silu model.dropout_p=0.001 model.forward_model.decoder.fixed_components=false logger.project=spectrometer_only_swir3_finetuning transforms=log_targets_log_proxy_log_albedo_log_reff task.final_eval=true task.save_predictions=true seed=0 task.train_frac=1.0 trainer=lightning_finetuning trainer.max_epochs=25 +task.model_path=$model_path model.lr=1e-6 model.lr_decay=1.0 model.lr_start_factor=1.0 +model.loss_scale=0.00001 model.jacobian_proj_loss_scale=0.0001 dataloader.batch_size=64 #model.jacobian_subspace_loss_scale=0.01 model.jacobian_proj_loss_scale=0.0 #1e16

