#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=120G
#SBATCH --gpus=1
#SBATCH --job-name=train_test
#SBATCH --time=10:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

export TORCH_USE_CUDA_DSA=1

nvidia-smi

srun python train_eval.py \
    device=snellius \
    dataset=synthetic_remotap_swir1_spectrometer_only_LHS \
    model=MLP_PCA_old_lr_schedule \
    model.forward_model.core_nn.n_fc_layers=5 \
    model.output_latent_dim=128 \
    model.hidden_dim=128 \
    model.nonlinearity=silu \
    model.forward_model.decoder.fixed_components=false \
    logger.project=spectrometer_only_swir1 \
    transforms=log_targets_log_proxy_log_albedo_log_reff \
    task.final_eval=true \
    task.save_predictions=true \
    seed=0 \
    task.train_frac=0.2 \
    trainer.max_epochs=25 \
    model.lr=1e-3