#!/bin/bash

#SBATCH --partition=rome
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=36
#SBATCH --mem=240G
#SBATCH --job-name=train_test
#SBATCH --time=10:00:00
#SBATCH --output=slurm_output_%A_%a.out


export PYTHONPATH=$PYTHONPATH:/$HOME/SRON/surrogate_rtm

cd $HOME/SRON/surrogate_rtm/scripts
source activate rtm_env

srun python train_eval.py device=snellius dataset=synthetic_remotap_swir3_ratio_spectrometer_only_matched_retrieval_era5 model=MLP_PCA_Ratio model.output_latent_dim=220 model.input_latent_dim=220 model.hidden_dim=220 model.nonlinearity=silu model.dropout_p=0.001 model.forward_model.decoder.fixed_components=true logger.project=spectrometer_only_swir3_era5 transforms=log_targets_log_proxy_log_albedo_log_reff_era5 task.final_eval=true task.save_predictions=true seed=0 task.train_frac=1.0 trainer.max_epochs=50 model.lr=1e-3 device.accelerator=cpu